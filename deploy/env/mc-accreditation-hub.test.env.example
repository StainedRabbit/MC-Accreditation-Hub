# Restricted test template. Use synthetic data and secrets managed outside Git.
DJANGO_SECRET_KEY=REPLACE_WITH_UNIQUE_TEST_SECRET
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_INTERNAL_TEST_HOSTNAME
CSRF_TRUSTED_ORIGINS=https://REPLACE_WITH_INTERNAL_TEST_HOSTNAME
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=0

RESTRICTED_TEST_MODE=1
# Address/CIDR of the sole Nginx peer as seen by Gunicorn. No default trust.
TEST_TRUSTED_PROXY_NETWORKS=
# Approved management client CIDRs. Blank keeps Django admin inaccessible.
TEST_ADMIN_NETWORKS=
TEST_AUTH_LIMIT_PER_MINUTE=10

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=REPLACE_WITH_ISOLATED_TEST_DATABASE
PGUSER=REPLACE_WITH_LEAST_PRIVILEGE_TEST_USER
PGPASSWORD=REPLACE_WITH_TEST_DATABASE_SECRET
PRIVATE_MEDIA_ROOT=/srv/mc-accreditation/private-media

# Administrator-assisted recovery remains the pilot path.
PASSWORD_RESET_ENABLED=0
