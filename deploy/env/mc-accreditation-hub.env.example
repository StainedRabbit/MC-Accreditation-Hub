# Install as /etc/mc-accreditation-hub.env with owner root:mc-hub and mode 0640.
DJANGO_SECRET_KEY=replace-with-a-unique-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=accreditation.example.edu
CSRF_TRUSTED_ORIGINS=https://accreditation.example.edu
DJANGO_SECURE_SSL_REDIRECT=1
# Start with one day after HTTPS verification; raise only through an approved change.
DJANGO_SECURE_HSTS_SECONDS=86400

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mc_accreditation
PGUSER=mc_accreditation_app
PGPASSWORD=replace-with-a-secret-managed-outside-git

# This directory must not be under Nginx's public document root.
PRIVATE_MEDIA_ROOT=/srv/mc-accreditation/private-media

# Leave disabled until the school SMTP service and public hostname are approved.
PASSWORD_RESET_ENABLED=0
DEFAULT_FROM_EMAIL=accreditation@example.edu
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=1
PASSWORD_RESET_FRONTEND_URL=https://accreditation.example.edu/

# Backup operator configuration. Backups include this file and must be encrypted/restricted.
BACKUP_ROOT=/srv/mc-accreditation/backups
MC_ENV_FILE=/etc/mc-accreditation-hub.env
