# Set these as Railway service variables. Replace every example value first.
DJANGO_SECRET_KEY=replace-with-a-unique-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.example.edu
CSRF_TRUSTED_ORIGINS=https://hub.example.edu
CORS_ALLOWED_ORIGINS=https://hub.example.edu
DJANGO_TRUST_PROXY_SSL=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=86400
DJANGO_SESSION_COOKIE_SAMESITE=Lax

# Use the Supabase dashboard's Session pooler connection details for Railway's
# default IPv4 egress. Keep the database password in Railway's secret variable.
PGHOST=replace-with-supabase-session-pooler-host
PGPORT=5432
PGDATABASE=postgres
PGUSER=replace-with-supabase-pooler-user
PGPASSWORD=replace-with-database-password
PGSSLMODE=require

PRIVATE_MEDIA_ROOT=/app/private-media

# Use credentials scoped to the existing private R2 bucket.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=replace-with-existing-private-bucket-name
R2_UPLOAD_URL_TTL=300
