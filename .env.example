DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mc_hub
PGUSER=mc_hub
PGPASSWORD=replace-with-your-database-password
# Optional absolute path outside the publicly served frontend/static folders:
# PRIVATE_MEDIA_ROOT=C:/MC-Hub/private-media
# Password recovery remains disabled until SMTP and a public HTTPS app URL are configured:
# PASSWORD_RESET_ENABLED=1
# DEFAULT_FROM_EMAIL=accreditation@example.edu
# EMAIL_HOST=smtp.example.edu
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# EMAIL_USE_TLS=1
# PASSWORD_RESET_FRONTEND_URL=https://accreditation.example.edu/
